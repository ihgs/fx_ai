{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/storybook-static/**": true,
    "**/data/*.db*": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/storybook-static": true
  },
  "typescript.tsserver.useSyntaxServer": "never",
  "js/ts.tsserver.useSyntaxServer": "never",
  "typescript.tsserver.log": "off"
}
